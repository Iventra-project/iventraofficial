# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The app origin, without a path. Use this exact origin when registering OAuth callbacks.
APP_URL="http://localhost:3000"

# Google OAuth callback: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth callback: http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Brevo: use a sender email registered in your Brevo account.
BREVO_API_KEY=""
EMAIL_FROM="Iventra <noreply@your-domain.com>"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_OTP_SECRET=""

# JWT Secret: Gunakan string acak panjang dan aman untuk production.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GANTI_DENGAN_SECRET_AMAN_MINIMAL_32_KARAKTER"

# Durasi token JWT (default: 7 hari)
JWT_EXPIRES_IN="7d"

# SUPABASE CONFIGURATION (Untuk Production / Cloud Hosting)
# Buat project di https://supabase.com lalu salin kredensial API & connection string
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"
